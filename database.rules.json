{
  "rules": {
    "pending_binds": {
      "$code": {
        ".read": true,
        ".write": true
      }
    },
    "parents": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "children": {
          "$childId": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "devices": {
      ".read": true,
      ".write": true,
      "$code": {
        ".read": true,
        ".write": true,
        "notifications": {
          ".read": true,
          ".write": true
        },
        "alerts": {
          ".read": true,
          ".write": true
        },
        "location": {
          ".read": true,
          ".write": true
        },
        "locationHistory": {
          ".read": true,
          ".write": true
        },
        "appUsage": {
          ".read": true,
          ".write": true
        },
        "callLogs": {
          ".read": true,
          ".write": true
        },
        "screen": {
          ".read": true,
          ".write": true
        },
        "signaling": {
          ".read": true,
          ".write": true
        },
        "stream": {
          ".read": true,
          ".write": true
        },
        "screenSignaling": {
          ".read": true,
          ".write": true
        }
      }
    },
    "pairings": {
      "$code": {
        ".read": true,
        ".write": true
      }
    },
    "pairing_codes": {
      "$deviceId": {
        ".read": true,
        ".write": true
      }
    },
    "user_pairing_codes": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "control": {
      "$code": {
        ".read": true,
        ".write": true
      }
    }
  }
}
